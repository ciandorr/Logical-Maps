import Classicism.Models.GluedFreeMonoid
import Classicism.Semantics.IntensionalExamples
import Mathlib.GroupTheory.CoprodI

/-!
# The free-product member of `glued-free-monoid`

`full-free-product-glued-constants`: the full one-object action model over the free product
`F_∞ * E * B * ℤ₂` of the free monoid on the sites, the idempotent monoid `{1, e}`, the
bicyclic monoid and the two-element group, with one individual, the constants glued by
formulas at the free generators, at `Σ = {c : t}`.

The one-object category here composes in the order of application, `f ≫ g = f * g`
(`MonObj`), where the record writes `u ∘ h = uh`; so the monoid here is the opposite of the
record's, which is isomorphic to it factor by factor: the free monoid by reversal, `E` and
`ℤ₂` being commutative, and the bicyclic monoid by exchanging its generators. Accordingly
the bicyclic factor is presented with `b * c = 1` (`b` first, then `c`), as the
transformations `pred` and `succ` of `ℕ` generate it (`Bicyclic`), and the sites are the
products `f_k * u`, the generator applied first.

What is proved: the generators are sites (`sites_sep`, by the normal form of the free
product, `Monoid.CoprodI.Word.equivPair` at the free factor), so **Logical Necessity** holds;
and the conditions on arrows the map's arguments use: a non-identity arrow and a non-epic one
(`e`, with `e * 1 = e * e`), an unretracted one (`e`, mapped to `E`), a returning one (`b`,
retracted by `c`), infinitely many propositions, one individual. Not yet: the record's
`unique-retractions-everywhere` (its Lemma 3, every arrow having at most one retraction),
which needs the free product's normal forms in full.
-/

namespace Classicism.Meta.Intensional

open CategoryTheory

/-! ### A monoid as a one-object category, composing in the order of application -/

/-- The one object of a monoid. -/
inductive MonObj (M : Type)
  | star

instance (M : Type) : Subsingleton (MonObj M) := ⟨fun | .star, .star => rfl⟩

/-- A monoid as a category: `f ≫ g` is `f * g`, `f` applied first. -/
instance (M : Type) [Monoid M] : SmallCategory (MonObj M) where
  Hom _ _ := M
  id _ := 1
  comp f g := f * g
  id_comp := one_mul
  comp_id := mul_one
  assoc := mul_assoc

/-! ### The factors -/

/-- The bicyclic monoid, as the transformations of `ℕ` generated by `pred` and `succ`. -/
abbrev Bicyclic : Type := Submonoid.closure ({Nat.pred, Nat.succ} : Set (Function.End ℕ))

namespace Bicyclic

/-- `b`, `pred`. -/
def b : Bicyclic := ⟨Nat.pred, Submonoid.subset_closure (Set.mem_insert _ _)⟩
/-- `c`, `succ`. -/
def c : Bicyclic := ⟨Nat.succ, Submonoid.subset_closure (Set.mem_insert_of_mem _ rfl)⟩

/-- `b * c = 1`: `pred ∘ succ` is the identity. -/
theorem b_mul_c : b * c = 1 := Subtype.ext (funext fun _ => rfl)

theorem b_ne_one : b ≠ 1 := fun e => by
  have := congrFun (congrArg Subtype.val e) 1
  change Nat.pred 1 = 1 at this
  exact absurd this (by decide)

end Bicyclic

/-- The index of the factors. -/
inductive FPIdx
  | free
  | idem
  | bicyc
  | invol
  deriving DecidableEq

/-- The factors: the free monoid on `G`, `E`, the bicyclic monoid, `ℤ₂`. -/
@[reducible] def FPFactor (G : Type) : FPIdx → Type
  | .free => FreeMonoid G
  | .idem => Idem
  | .bicyc => Bicyclic
  | .invol => Invol

instance (G : Type) : ∀ i, Monoid (FPFactor G i)
  | .free => inferInstanceAs (Monoid (FreeMonoid G))
  | .idem => inferInstanceAs (Monoid Idem)
  | .bicyc => inferInstanceAs (Monoid Bicyclic)
  | .invol => inferInstanceAs (Monoid Invol)

/-- The free product `F_∞ * E * B * ℤ₂`. -/
abbrev FreeProd (G : Type) : Type := Monoid.CoprodI (FPFactor G)

namespace FreeProd

open Monoid.CoprodI

variable {G : Type}

/-- The free generator `f_k`. -/
abbrev f (k : G) : FreeProd G := of (i := .free) (FreeMonoid.of k)
/-- The idempotent `e`. -/
abbrev e : FreeProd G := of (i := .idem) Idem.k
/-- The bicyclic generators. -/
abbrev b : FreeProd G := of (i := .bicyc) Bicyclic.b
abbrev c : FreeProd G := of (i := .bicyc) Bicyclic.c

theorem e_mul_e : (e : FreeProd G) * e = e := by
  rw [← map_mul]
  rfl

theorem b_mul_c : (b : FreeProd G) * c = 1 := by
  rw [← map_mul, Bicyclic.b_mul_c, map_one]

theorem e_ne_one : (e : FreeProd G) ≠ 1 := fun h =>
  Idem.k_ne_one (of_injective (M := FPFactor G) FPIdx.idem (h.trans (map_one _).symm))

theorem b_ne_one : (b : FreeProd G) ≠ 1 := fun h =>
  Bicyclic.b_ne_one (of_injective (M := FPFactor G) FPIdx.bicyc (h.trans (map_one _).symm))

/-- The projection onto `E`. -/
noncomputable def toIdem : FreeProd G →* Idem :=
  lift fun i => match i with
    | .free => 1
    | .idem => MonoidHom.id Idem
    | .bicyc => 1
    | .invol => 1

theorem toIdem_e : toIdem (e : FreeProd G) = Idem.k := lift_of _ _

/-- `e` has no right inverse: its projection onto `E` would. -/
theorem e_mul_ne_one (m : FreeProd G) : e * m ≠ 1 := fun h => by
  have := congrArg toIdem h
  rw [map_mul, toIdem_e, map_one] at this
  revert this
  generalize toIdem m = x
  cases x <;> decide

section Words

open Classical in
/-- **The free generators are sites**: `f_k * u = f_k' * u'` only when `k = k'` and `u = u'`,
read off the normal forms at the free factor. -/
theorem sites_sep {k k' : G} {u u' : FreeProd G} (h : f k * u = f k' * u') : k = k' ∧ u = u' := by
  classical
  have hw := congrArg (fun x : FreeProd G => Word.equivPair FPIdx.free (Word.equiv x)) h
  simp only [Word.equiv, Equiv.coe_fn_mk, mul_smul, Word.equivPair_smul_same] at hw
  obtain ⟨hh, ht⟩ := Word.Pair.ext_iff.1 hw
  have hl := congrArg FreeMonoid.toList hh
  simp only [FreeMonoid.toList_mul, FreeMonoid.toList_of, List.singleton_append,
    List.cons.injEq] at hl
  refine ⟨hl.1, ?_⟩
  have hp : Word.equivPair FPIdx.free (u • Word.empty) = Word.equivPair FPIdx.free (u' • Word.empty) :=
    Word.Pair.ext (FreeMonoid.toList.injective hl.2) ht
  exact Word.equiv.injective ((Word.equivPair FPIdx.free).injective hp)

end Words

end FreeProd

/-! ### The member -/

/-- The sites of the member: lists of constants of `Σ = {c : t}` with pure formulas. -/
abbrev FPS : Type := Premodel.Datum Signature.sigmaTop

/-- The free generators are sites, with one individual. -/
def FreeProd.sites : Sites (FullActionModels.unitDe (MonObj (FreeProd FPS))) .star FPS where
  s k := (FreeProd.f k : FreeProd FPS)
  sep {V} k k' u u' h := by
    obtain rfl : V = .star := Subsingleton.elim _ _
    exact FreeProd.sites_sep (u := u) (u' := u') h
  glue_e _ := ⟨(), fun _ => rfl⟩

/-- The glued model of `full-free-product-glued-constants`. -/
noncomputable abbrev fpModel : Premodel Signature.sigmaTop (MonObj (FreeProd FPS)) :=
  Premodel.glued (FullActionModels.unitDe (MonObj (FreeProd FPS))) MonObj.star (fun _ => ⟨()⟩)
    FreeProd.sites
    (Premodel.byFormulas (FullActionModels.unitDe (MonObj (FreeProd FPS))) MonObj.star fun _ => ⟨()⟩)

/-- **`full-free-product-glued-constants`**: the free product with the constants glued by
formulas at the free generators, one individual. -/
noncomputable def freeProductSites : GluedData where
  C := MonObj (FreeProd FPS)
  W₀ := .star
  De := FullActionModels.unitDe _
  ne _ := ⟨()⟩
  G := FPS
  S := FreeProd.sites
  Sig := Signature.sigmaTop
  w := Premodel.byFormulas (FullActionModels.unitDe (MonObj (FreeProd FPS))) MonObj.star fun _ => ⟨()⟩

namespace FreeProductSites

open FreeProd

local notation "A" => fpModel

theorem isModel : (A).IsModel := Premodel.glued_isModel _ _

theorem full : (A).Full := Premodel.glued_full _ _

theorem oneObject : (A).OneObject := inferInstance

theorem one_individual : (A).OneIndividual := fun _ => (inferInstance : Subsingleton Unit)

theorem identity_singletons : (A).IdentitySingletons := Premodel.Full.identitySingletons _ full

/-- `e`, an arrow other than the identity. -/
theorem nonidentity : (A).NonidentityArrow :=
  ⟨.star, (FreeProd.e : FreeProd FPS), fun h => e_ne_one (Prod.mk.inj (eq_of_heq (Sigma.mk.inj_iff.1 h).2)).2⟩

/-- `e * 1 = e * e`, with `1 ≠ e`. -/
theorem nonepic : (A).NonepicArrow :=
  ⟨.star, .star, (FreeProd.e : FreeProd FPS), (1 : FreeProd FPS), (FreeProd.e : FreeProd FPS),
    e_ne_one.symm, by
      show (FreeProd.e : FreeProd FPS) * 1 = FreeProd.e * FreeProd.e
      rw [mul_one, e_mul_e]⟩

/-- `e` has no retraction. -/
theorem unretracted : (A).UnretractedArrow :=
  ⟨.star, (FreeProd.e : FreeProd FPS), fun m h => e_mul_ne_one m h⟩

/-- `b`, retracted by `c`. -/
theorem returning : (A).ReturningArrow :=
  ⟨.star, (FreeProd.b : FreeProd FPS), (FreeProd.c : FreeProd FPS), b_mul_c,
    fun h => b_ne_one (Prod.mk.inj (eq_of_heq (Sigma.mk.inj_iff.1 h).2)).2⟩

/-- Infinitely many propositions: the singletons of the powers of a free generator. -/
theorem infinitely_many_propositions : (A).InfinitelyManyPropositions := by
  change Infinite (Set (Σ V : MonObj (FreeProd FPS), PUnit × ((MonObj.star : MonObj (FreeProd FPS)) ⟶ V)))
  let d : FPS := ⟨[], Term.top⟩
  have : Infinite (Σ V : MonObj (FreeProd FPS), PUnit × ((MonObj.star : MonObj (FreeProd FPS)) ⟶ V)) :=
    Infinite.of_injective (fun n : ℕ => (⟨.star, PUnit.unit,
        (Monoid.CoprodI.of (i := FPIdx.free) (FreeMonoid.ofList (List.replicate n d)) : FreeProd FPS)⟩ :
      Σ V : MonObj (FreeProd FPS), PUnit × ((MonObj.star : MonObj (FreeProd FPS)) ⟶ V))) fun _ _ h => by
        obtain ⟨_, hh⟩ := Sigma.mk.inj_iff.mp h
        have := congrArg (fun l => List.length (FreeMonoid.toList l))
          (Monoid.CoprodI.of_injective (M := FPFactor FPS) FPIdx.free (Prod.mk.inj (eq_of_heq hh)).2)
        simpa using this
  exact Infinite.of_injective (fun x => ({x} : Set _)) Set.singleton_injective

/-- **Logical Necessity**: the values by formulas are rich, and the model has one object. -/
theorem logicalNecessity : (A).HoldsAx (AxiomSet.logicalNecessity Signature.sigmaTop) :=
  Premodel.holdsAx_logicalNecessity (C := MonObj (FreeProd FPS)) _ _ (Premodel.byFormulas_rich _ _ _)

end FreeProductSites

end Classicism.Meta.Intensional
