{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "result.schema.json",
 "title": "Result",
 "description": "An implication: premises entail a principle or False. A False conclusion records incompatibility. Counterexamples to implications are recorded as models.",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "id",
  "premises",
  "conclusion",
  "certificate",
  "sources"
 ],
 "properties": {
  "id": {
   "type": "string",
   "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
  },
  "premises": {
   "type": "array",
   "items": {
    "type": "string"
   },
   "uniqueItems": true
  },
  "conclusion": {
   "oneOf": [
    {
     "type": "string"
    },
    {
     "const": false
    }
   ],
   "description": "A principle id, or false (YAML boolean false or the string \"false\") for incompatible premises. False is a logical constant, not a principle."
  },
  "status": {
   "type": "string",
   "enum": [
    "proved",
    "conjectured"
   ],
   "default": "conjectured"
  },
  "was_conjectured": {
   "type": "boolean",
   "description": "Historical marker for a record that began as a conjecture. It does not change proof status or supply inference evidence."
  },
  "certificate": {
   "type": "object",
   "additionalProperties": false,
   "anyOf": [
    {
     "required": [
      "source_id"
     ]
    },
    {
     "required": [
      "provenance"
     ]
    }
   ],
   "properties": {
    "source_id": {
     "type": "string",
     "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
     "description": "Mathematical source in topic.source_catalog; credit adaptations or alternative proofs separately. Use misc for original one-off work. Drives source filters and badges."
    },
    "provenance": {
     "type": "string",
     "enum": [
      "human",
      "human-assisted",
      "ai"
     ],
     "description": "Origin of the mathematical result or model, not authorship of its database transcription."
    },
    "lean": {
     "type": "string",
     "enum": [
      "none",
      "stated",
      "verified"
     ],
     "default": "none",
     "description": "none: no Lean statement. stated: the generated statement elaborates; its proof remains pending. verified: a checked proof of the generated statement using only propext, Classical.choice, and Quot.sound. Only pmap lean-check --update may set verified."
    },
    "lean_ref": {
     "type": "string"
    },
    "produced_by": {
     "type": "string"
    },
    "recorded_by": {
     "type": "string",
     "description": "Who transcribed or translated the database record, separately from the mathematical author."
    },
    "checked_by": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "date": {
     "type": "string"
    },
    "trawl": {
     "$ref": "#/properties/certificate/$defs/trawl",
     "description": "Structured discovery, informal review and local admission history. Model identity and timestamps are runner supplied. Does not imply Lean verification or Git publication. The original mathematical source remains source_id. Existing records need no migration."
    }
   },
   "if": {
    "properties": {
     "lean": {
      "const": "verified"
     }
    },
    "required": [
     "lean"
    ]
   },
   "then": {
    "required": [
     "lean_ref"
    ]
   },
   "$defs": {
    "trawlActor": {
     "oneOf": [
      {
       "type": "object",
       "additionalProperties": false,
       "required": [
        "kind",
        "name"
       ],
       "properties": {
        "kind": {
         "const": "human"
        },
        "name": {
         "type": "string",
         "minLength": 1
        }
       }
      },
      {
       "type": "object",
       "additionalProperties": false,
       "required": [
        "kind",
        "provider",
        "model"
       ],
       "properties": {
        "kind": {
         "const": "model"
        },
        "provider": {
         "type": "string",
         "minLength": 1
        },
        "model": {
         "type": "string",
         "minLength": 1
        },
        "reported_model": {
         "type": "string",
         "minLength": 1
        },
        "protocol": {
         "type": "string",
         "minLength": 1
        },
        "endpoint": {
         "type": "string",
         "minLength": 1
        }
       }
      }
     ]
    },
    "trawlSource": {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "repository",
      "ref",
      "commit"
     ],
     "properties": {
      "repository": {
       "type": "string",
       "minLength": 1
      },
      "ref": {
       "type": "string",
       "minLength": 1
      },
      "commit": {
       "type": "string",
       "pattern": "^[0-9a-f]{40,64}$"
      }
     }
    },
    "trawlDiscovery": {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "attempt_id",
      "at",
      "actor",
      "prompt_sha256",
      "response_sha256",
      "usage",
      "response_id",
      "offline"
     ],
     "properties": {
      "attempt_id": {
       "type": "string",
       "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
      },
      "at": {
       "type": "string",
       "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d(?:\\.\\d+)?\\+00:00$"
      },
      "actor": {
       "$ref": "#/properties/certificate/$defs/trawlActor"
      },
      "prompt_sha256": {
       "type": "string",
       "pattern": "^[0-9a-f]{64}$"
      },
      "response_sha256": {
       "type": "string",
       "pattern": "^[0-9a-f]{64}$"
      },
      "usage": {
       "type": "object"
      },
      "response_id": {
       "type": [
        "string",
        "null"
       ]
      },
      "offline": {
       "const": false
      }
     }
    },
    "trawlReview": {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "version",
      "id",
      "candidate_id",
      "candidate_sha256",
      "at",
      "actor",
      "source",
      "report",
      "method",
      "recorded_at"
     ],
     "properties": {
      "version": {
       "const": 1
      },
      "id": {
       "type": "string",
       "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
      },
      "candidate_id": {
       "type": "string",
       "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
      },
      "candidate_sha256": {
       "type": "string",
       "pattern": "^[0-9a-f]{64}$"
      },
      "at": {
       "type": "string",
       "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d(?:\\.\\d+)?\\+00:00$"
      },
      "actor": {
       "$ref": "#/properties/certificate/$defs/trawlActor"
      },
      "source": {
       "$ref": "#/properties/certificate/$defs/trawlSource"
      },
      "report": {
       "type": "object",
       "additionalProperties": false,
       "required": [
        "verdict",
        "summary",
        "argument_check",
        "source_check",
        "issues"
       ],
       "properties": {
        "verdict": {
         "enum": [
          "accept",
          "revise",
          "reject",
          "inconclusive"
         ]
        },
        "summary": {
         "type": "string",
         "minLength": 1
        },
        "argument_check": {
         "type": "string",
         "minLength": 1
        },
        "source_check": {
         "type": "string",
         "minLength": 1
        },
        "issues": {
         "type": "array",
         "items": {
          "type": "string",
          "minLength": 1
         }
        }
       }
      },
      "method": {
       "const": "informal-mathematical-review"
      },
      "attempt": {
       "$ref": "#/properties/certificate/$defs/trawlDiscovery"
      },
      "recorded_at": {
       "type": "string",
       "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d(?:\\.\\d+)?\\+00:00$"
      }
     }
    },
    "trawl": {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "quarantine_id",
      "candidate_id",
      "candidate_sha256",
      "source",
      "discovery",
      "evidence",
      "reviews",
      "admission"
     ],
     "properties": {
      "quarantine_id": {
       "type": "string",
       "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
      },
      "candidate_id": {
       "type": "string",
       "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
      },
      "candidate_sha256": {
       "type": "string",
       "pattern": "^[0-9a-f]{64}$"
      },
      "source": {
       "$ref": "#/properties/certificate/$defs/trawlSource"
      },
      "discovery": {
       "$ref": "#/properties/certificate/$defs/trawlDiscovery"
      },
      "evidence": {
       "type": "array",
       "minItems": 1,
       "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
         "kind",
         "citation",
         "locator",
         "role",
         "verification"
        ],
        "properties": {
         "kind": {
          "enum": [
           "original-argument",
           "database-record",
           "literature",
           "computation"
          ]
         },
         "citation": {
          "type": "string",
          "minLength": 1
         },
         "locator": {
          "type": "string",
          "minLength": 1
         },
         "role": {
          "enum": [
           "origin",
           "proof",
           "background",
           "related"
          ]
         },
         "verification": {
          "enum": [
           "supplied-context",
           "unverified",
           "argument-in-writeup"
          ]
         }
        }
       }
      },
      "reviews": {
       "type": "array",
       "minItems": 1,
       "items": {
        "$ref": "#/properties/certificate/$defs/trawlReview"
       }
      },
      "admission": {
       "type": "object",
       "additionalProperties": false,
       "required": [
        "id",
        "at",
        "by",
        "base_commit",
        "candidate_sha256",
        "review_id"
       ],
       "properties": {
        "id": {
         "type": "string",
         "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "at": {
         "type": "string",
         "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d(?:\\.\\d+)?\\+00:00$"
        },
        "by": {
         "type": "string",
         "minLength": 1
        },
        "base_commit": {
         "type": "string",
         "pattern": "^[0-9a-f]{40,64}$"
        },
        "candidate_sha256": {
         "type": "string",
         "pattern": "^[0-9a-f]{64}$"
        },
        "review_id": {
         "type": "string",
         "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        }
       }
      }
     }
    }
   }
  },
  "proof": {
   "type": "string"
  },
  "sources": {
   "type": "array",
   "items": {
    "type": "string",
    "pattern": "\\S"
   }
  },
  "source_names": {
   "type": "array",
   "items": {
    "type": "string",
    "pattern": "\\S"
   },
   "description": "Short display names, one per sources entry in the same order; full citations remain in sources."
  },
  "notes": {
   "type": "string"
  },
  "references": {
   "type": "array",
   "description": "References to papers.yaml; roles distinguish definition origins and background from direct proofs.",
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "paper",
     "role"
    ],
    "properties": {
     "paper": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
     },
     "role": {
      "enum": [
       "origin",
       "formulation",
       "proof",
       "background",
       "related"
      ]
     },
     "locator": {
      "type": "string",
      "minLength": 1
     },
     "note": {
      "type": "string",
      "minLength": 1
     }
    }
   }
  },
  "changes": {
   "type": "array",
   "description": "Dated revision log. Append an entry whenever a record gains content after its certificate date (new verified properties, an added proof, a corrected statement). The Changes tab lists each entry under its own date; certificate.date stays the record's original date.",
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "date",
     "summary"
    ],
    "properties": {
     "date": {
      "type": "string",
      "description": "ISO date of the revision."
     },
     "by": {
      "type": "string",
      "description": "Who supplied the revision's content (author or agent, with date if useful)."
     },
     "summary": {
      "type": "string",
      "minLength": 1,
      "description": "What changed and why, in one or two sentences."
     }
    }
   }
  },
  "tier": {
   "type": "string",
   "enum": [
    "bronze",
    "silver",
    "gold"
   ],
   "description": "Human ranking of an unresolved question by importance and difficulty, shown on its lynchpin star. A conjecture with notes is bronze on its own; silver and gold are given by hand."
  }
 },
 "if": {
  "properties": {
   "status": {
    "const": "conjectured"
   }
  }
 },
 "else": {
  "required": [
   "proof"
  ]
 }
}
